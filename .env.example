DISCORD_TOKEN=

# Public deployment only: a DNS name pointed at your server.
DOMAIN=compressor.example.com

# Local testing: only this Mac can open the link.
WEB_HOST=127.0.0.1
WEB_PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Recommended: restrict commands to these comma-separated Discord servers.
ALLOWED_GUILD_IDS=

JOB_TTL_MINUTES=30
USER_COOLDOWN_SECONDS=15
MAX_ACTIVE_JOBS=250

# Maximum combined size of already-compressed results held in memory.
MAX_RESULT_TOTAL_MIB=220
