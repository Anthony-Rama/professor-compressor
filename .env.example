DISCORD_TOKEN=

# Optional private Discord webhook for install, removal, and usage alerts.
ALERT_WEBHOOK_URL=

# Optional server ID where the private owner-only /botstats command is registered.
BOTSTATS_GUILD_ID=

# Public deployment only: a DNS name pointed at your server.
DOMAIN=compressor.example.com

# Local testing: only this Mac can open the link.
WEB_HOST=127.0.0.1
WEB_PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Recommended: restrict commands to these comma-separated Discord servers.
ALLOWED_GUILD_IDS=

JOB_TTL_MINUTES=10
ACTIVE_SESSION_TTL_MINUTES=30
USER_COOLDOWN_SECONDS=15
MAX_ACTIVE_JOBS=250
UPLOAD_RATE_LIMIT_PER_MINUTE=8
MAX_CONCURRENT_UPLOADS=2
DELIVERY_QUEUE_SIZE=8
DELIVERY_WORKERS=2
MAX_DELIVERY_BUFFER_MIB=400

# Maximum combined size of already-compressed results held in memory.
MAX_RESULT_TOTAL_MIB=220
