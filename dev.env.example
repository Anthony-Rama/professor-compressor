# Copy to dev.env, fill in the separate dev credentials, then chmod 600 dev.env.
DISCORD_TOKEN=YOUR_DEV_BOT_TOKEN
DEV_APPLICATION_ID=YOUR_DEV_APPLICATION_ID
ALLOWED_GUILD_IDS=YOUR_TEST_SERVER_ID
WEB_HOST=127.0.0.1
WEB_PORT=8080
PUBLIC_BASE_URL=https://YOUR-TUNNEL.trycloudflare.com

# Optional: a separate 32+ character dev dashboard key. Never reuse production's.
OBSERVABILITY_ADMIN_KEY=

# The dev launcher deliberately disables external publishing and webhooks.
TOPGG_API_TOKEN=
DSC_API_TOKEN=
ALERT_WEBHOOK_URL=
